<main class="onboarding">
  <h1>Set up your subscription</h1>

  <%# This is the master file for turbo to handle our smooth form partial reloads %>
  <%= turbo_frame_tag "onboarding_step" do %>
    <% if @wizard.finished? %>
      <%= render "success", wizard: @wizard %>
    <% else %>
      <%# At the top: 1. Account / 2. Plan / 3. Confirm %>
      <%= render "progress", wizard: @wizard %>

      <%# Example: An account with this email already exists. %>
      <% if @wizard.error.present? %>
        <p class="form-error" role="alert">
          <%= @wizard.error %>
        </p>
      <% end %>

      <%# Get our form data %>
      <%= form_with url: onboarding_path(step: @wizard.step),
                    method: :patch,
                    autocomplete: "on" do |form| %>
        <%# Render the partial for the step we are on (and the form) %>
        <%= render "#{@wizard.step}_step", form: form, wizard: @wizard %>
      <% end %>
    <% end %>
  <% end %>
</main>
