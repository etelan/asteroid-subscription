<div class="plan-card">
  <h3><%= plan.name %></h3>

  <h4>
    <% if plan.min_diameter.zero? %>
      Less than <%= plan.max_diameter %>km in diameter
    <% else %>
      <%= plan.min_diameter %>km - <%= plan.max_diameter %>km in diameter
    <% end %>
  </h4>

  <p><%= plan.description %></p>
  <p>$<%= number_with_precision(plan.price, precision: 2) %> per month</p>
</div>