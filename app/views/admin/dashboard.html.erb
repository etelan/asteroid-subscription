<main class="admin-dashboard">
  <header class="admin-header">
    <div>
      <p class="eyebrow">Admin</p>
      <h1>Dashboard</h1>
    </div>

    <%= button_to "Sign out", admin_logout_path,
                  method: :delete,
                  class: "button secondary" %>
  </header>

  <section class="admin-summary">
    <div class="card">
      <p>Total users</p>
      <strong><%= User.count %></strong>
    </div>

    <div class="card">
      <p>Total asteroids</p>
      <strong><%= Asteroid.count %></strong>
    </div>

    <div class="card">
      <p>Total plans</p>
      <strong><%= Plan.count %></strong>
    </div>
  </section>

  <section class="admin-users">
    <h2>Users</h2>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Address</th>
          <th>Plan</th>
          <th>Plan start</th>
          <th>Upcoming asteroid</th>
          <th>User id</th>
          <th>Admin</th>
          <th>Created</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><%= user.address %></td>
            <td>
              <% if user.plan %>
                <%= link_to user.plan.name, plan_path(user.plan) %>
              <% end %>
            </td>
            <td><%= user.plan_start_date %></td>
            <td>
              <% if user.upcoming_asteroid %>
                <%= link_to user.upcoming_asteroid.full_name, asteroid_path(user.upcoming_asteroid) %>
                (<%= user.upcoming_asteroid.id %>)
              <% end %>
            </td>
            <td><%= user.id %></td>
            <td><%= user.is_admin? ? "yes" : "no" %></td>
            <td><%= user.created_at.to_date %></td>
            <td><%= user.updated_at.to_date %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section class="admin-plans">
    <h2>Plans</h2>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Price</th>
          <th>Range</th>
          <th>Asteroids</th>
          <th>ID</th>
          <th>Created</th>
          <th>Updated</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <% @plans.each do |plan| %>
          <tr>
            <td><%= link_to plan.name, plan_path(plan) %></td>
            <td>$<%= number_with_precision(plan.price, precision: 0) %>/month</td>
            <td><%= plan.min_diameter %> km – <%= plan.max_diameter %> km</td>
            <td><%= Asteroid.where(diameter: plan.min_diameter..plan.max_diameter).count %></td>
            <td><%= plan.id %></td>
            <td><%= plan.created_at.to_date %></td>
            <td><%= plan.updated_at.to_date %></td>
            <td><%= plan.description.presence || "No description available." %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</main>